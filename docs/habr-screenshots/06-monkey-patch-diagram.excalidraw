    {"type": "text", "id": "code_block", "x": 270, "y": 955, "width": 1120, "height": 220, "text": "from httpcore._backends.auto import AutoBackend\nfrom telegram.request import HTTPXRequest\n\nclass HardcodedIPBackend(AutoBackend):\n    async def connect_tcp(self, host, port, *args, **kwargs):\n        if host == \"api.telegram.org\":\n            host = \"149.154.167.220\"        # ← единственный рабочий DC-IP\n        return await super().connect_tcp(host, port, *args, **kwargs)\n\ntransport = httpx.AsyncHTTPTransport()\ntransport._pool._network_backend = HardcodedIPBackend()\nreq = HTTPXRequest(httpx_kwargs={\"transport\": transport})\nApp.builder().token(TOKEN).request(req).get_updates_request(req).build()", "originalText": "from httpcore._backends.auto import AutoBackend\nfrom telegram.request import HTTPXRequest\n\nclass HardcodedIPBackend(AutoBackend):\n    async def connect_tcp(self, host, port, *args, **kwargs):\n        if host == \"api.telegram.org\":\n            host = \"149.154.167.220\"        # ← единственный рабочий DC-IP\n        return await super().connect_tcp(host, port, *args, **kwargs)\n\ntransport = httpx.AsyncHTTPTransport()\ntransport._pool._network_backend = HardcodedIPBackend()\nreq = HTTPXRequest(httpx_kwargs={\"transport\": transport})\nApp.builder().token(TOKEN).request(req).get_updates_request(req).build()", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#e2e8f0", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400005, "version": 1, "versionNonce": 400006, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25},

    {"type": "text", "id": "footnote", "x": 240, "y": 1195, "width": 1180, "height": 18, "text": "SSL handshake уровнем выше использует server_hostname=api.telegram.org → cert валидируется правильно, secure без CERT_NONE", "originalText": "SSL handshake уровнем выше использует server_hostname=api.telegram.org → cert валидируется правильно, secure без CERT_NONE", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400007, "version": 1, "versionNonce": 400008, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25}
